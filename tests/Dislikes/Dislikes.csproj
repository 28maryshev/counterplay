<Project Sdk="Microsoft.NET.Sdk">

  <!-- «Не советовать»: чемпион, которого игрок убрал кнопкой 👎, скрыт в
       советах пиков и банов на своей роли HideGames игр, потом возвращается
       по месту за игру. Движок — на живой базе (только чтение), окно —
       настоящее, но невидимое. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Counterplay.Tests</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Counterplay.csproj" />
  </ItemGroup>

</Project>
