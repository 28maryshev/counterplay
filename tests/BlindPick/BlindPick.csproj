<Project Sdk="Microsoft.NET.Sdk">

  <!-- Пик вслепую: математика «слепоты» (шансы, шум, усадка, худшее из пула)
       сходится с примерами на подставных числах, а подбор при первом пике и
       при части врагов ставит надёжных выше тех, кого легко законтрить.
       Математика — на подставных числах, подбор — на живой базе (только
       чтение). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Counterplay.Tests</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Counterplay.csproj" />
  </ItemGroup>

</Project>
