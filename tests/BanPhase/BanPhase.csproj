<Project Sdk="Microsoft.NET.Sdk">

  <!-- Фаза банов: контры к мейнам взвешены пикрейтом, тир-лист банов по ролям,
       после своего бана окно показывает баны обеих команд с бан-рейтом.
       Считается на живой базе, окно — настоящее, но невидимое. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Counterplay.Tests</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Counterplay.csproj" />
  </ItemGroup>

</Project>
