<Project Sdk="Microsoft.NET.Sdk">

  <!-- Экран готовности у разных игроков: ранкед, нормалы, Swiftplay, ARAM,
       Арена, перерыв, не вошёл в аккаунт. Настоящий путь первого запуска через
       подставной клиент League; отчёт по блокам и снимки. Своя папка на
       каждого игрока, невидимое окно. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Counterplay.Tests</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Counterplay.csproj" />
    <Compile Include="..\Shared\FakeLcu.cs" />
  </ItemGroup>

</Project>
