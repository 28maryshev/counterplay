<Project Sdk="Microsoft.NET.Sdk">

  <!-- Пул возит с собой хозяина: кто отдал файл и с кем настроена связка.
       Работает с НАСТОЯЩИМ pools.json — прежнее содержимое возвращается на
       место, в том числе при падении. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Counterplay.Tests</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Counterplay.csproj" />
  </ItemGroup>

</Project>
