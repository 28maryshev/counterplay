<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Общий вид для ВСЕХ окон программы. Словарь подмешивается в ресурсы
    приложения на старте (см. Program.cs), поэтому действует и в оверлее, и в
    окнах пулов, настроек и подтверждения — там разметки нет, окна собраны
    кодом, и до сих пор им доставалось системное оформление.
  -->

  <FontFamily x:Key="UiFont">/assets/fonts/#Geist, Segoe UI</FontFamily>

  <!--
    Всплывающая подсказка.

    Стиль БЕЗ ключа — значит его подхватывает каждая подсказка сама, включая
    короткие `ToolTip="Имя"`, которых в программе большинство. Раньше фирменный
    вид был только у трёх развёрнутых объяснений, а остальные выходили
    системной жёлто-белой плашкой посреди тёмного окна: на портретах чемпионов
    это особенно било в глаза.

    Тень системную гасим: у плашки своя рамка, а тень поверх прозрачного
    оверлея оставляет серый ореол.
  -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="#D7DEE6"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Placement" Value="Bottom"/>
    <Setter Property="HorizontalOffset" Value="2"/>
    <Setter Property="VerticalOffset" Value="4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="#F2141C28" BorderBrush="#4436D6E7" BorderThickness="1"
                  CornerRadius="8" Padding="11,9">
            <!-- Содержимое не трогаем: развёрнутые подсказки (руны, сборка)
                 верстают себя сами, и общий перенос по словам сломал бы им
                 раскладку. Короткие имена в переносе не нуждаются. -->
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Выпадающее меню.

    Тоже БЕЗ ключа и по той же причине, что подсказка: фирменный вид был только
    у меню ролей в оверлее, а всё остальное рисовалось системным шаблоном. У
    пунктов меню он держит слева колонку под галочку и значок, и на тёмном фоне
    она выходит белым прямоугольником — владелец это и увидел в новом меню
    выбора напарника.
  -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="#101823" BorderBrush="#557089" BorderThickness="1"
                  CornerRadius="6" Padding="4" Margin="0,2,6,6">
            <Border.Effect>
              <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel IsItemsHost="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="#C9D2DC"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" CornerRadius="4" Padding="12,5" Background="Transparent">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
              <Setter Property="Foreground" Value="#F5D77A"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="#F5D77A"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#6A7C8C"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Разделитель: системный рисует светлую полоску, на тёмном она режет глаз. -->
  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="8,4" Background="#2A3A4A"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
