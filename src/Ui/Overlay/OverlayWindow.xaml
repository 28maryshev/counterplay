<Window x:Class="Counterplay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Counterplay"
        Title="Counterplay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnDrag"
        PreviewMouseLeftButtonDown="OnAnyClick"
        KeyDown="OnKeyDown">

  <Window.Resources>
    <!-- Ресурсы и шаблоны окна — в отдельных словарях (OverlayResources.xaml
         и Templates/). Шаблоны с обработчиками событий передают их окну. -->
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Counterplay;component/src/Ui/Overlay/OverlayResources.xaml"/>
        <loc:TeamSlotTemplates/>
        <loc:PickCardTemplates/>
        <loc:BuildRowTemplates/>
        <loc:BanTemplates/>
        <loc:PlanTemplates/>
        <loc:TierTemplates/>
        <loc:RuneTemplates/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>

    <!-- ═══════════════ ОСНОВНОЙ КОНТЕНТ ═══════════════ -->
    <Border Background="#D8071223" BorderBrush="{StaticResource WaveBrush}" BorderThickness="1.4"
            CornerRadius="4" Margin="5">
      <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.7"/>
      </Border.Effect>

      <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>  <!-- шапка       -->
          <RowDefinition Height="Auto"/>  <!-- статус      -->
          <RowDefinition Height="*"/>     <!-- контент     -->
          <RowDefinition Height="Auto"/>  <!-- дисклеймер  -->
        </Grid.RowDefinitions>

        <!-- ── Декоративный фон в стиле клиента (полупрозрачный) ──────── -->
        <Grid Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True">
          <!-- мягкая диагональная подсветка -->
          <Rectangle>
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1636D6E7" Offset="0"/>
                <GradientStop Color="#00071223" Offset="0.45"/>
                <GradientStop Color="#0CFF5A4D" Offset="1"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>

          <!-- синее свечение сверху-слева (как левая половина логотипа) -->
          <Ellipse Width="560" Height="320" HorizontalAlignment="Left"
                   VerticalAlignment="Top" Margin="-140,-110,0,0">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#2636D6E7" Offset="0"/>
                <GradientStop Color="#0036D6E7" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <!-- красное свечение снизу-справа (как правая половина логотипа) -->
          <Ellipse Width="620" Height="360" HorizontalAlignment="Right"
                   VerticalAlignment="Bottom" Margin="0,0,-160,-120">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#10FF5A4D" Offset="0"/>
                <GradientStop Color="#00FF5A4D" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <!-- Потоки «ветра/дымки» — плавно дрейфуют -->
          <Canvas>
            <Canvas.Resources>
              <!-- общий стиль кривой -->
              <Style x:Key="Wisp" TargetType="Path">
                <Setter Property="Stroke" Value="{StaticResource WaveBrush}"/>
                <Setter Property="StrokeThickness" Value="1.6"/>
                <Setter Property="Opacity" Value="0.22"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
              </Style>
            </Canvas.Resources>

            <Path Style="{StaticResource Wisp}"
                  Data="M -80,90 C 220,30 520,170 820,90 S 1320,20 1640,130"
                  RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><TranslateTransform x:Name="W1"/></Path.RenderTransform>
              <Path.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="W1" Storyboard.TargetProperty="X"
                                       From="0" To="46" Duration="0:0:11"
                                       AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Path.Triggers>
            </Path>

            <Path Style="{StaticResource Wisp}" Opacity="0.07"
                  Data="M -80,260 C 260,200 560,330 880,250 S 1340,180 1660,300">
              <Path.RenderTransform><TranslateTransform x:Name="W2"/></Path.RenderTransform>
              <Path.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="W2" Storyboard.TargetProperty="X"
                                       From="0" To="-40" Duration="0:0:14"
                                       AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Path.Triggers>
            </Path>

            <Path Style="{StaticResource Wisp}" Opacity="0.06"
                  Data="M -80,440 C 240,380 540,510 860,430 S 1320,360 1660,470">
              <Path.RenderTransform><TranslateTransform x:Name="W3"/></Path.RenderTransform>
              <Path.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="W3" Storyboard.TargetProperty="X"
                                       From="0" To="36" Duration="0:0:17"
                                       AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Path.Triggers>
            </Path>
          </Canvas>
        </Grid>

        <!-- ── Шапка ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="12,10,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="{StaticResource BrandMark}" Width="22" Height="22"
                   Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="Bold"
                       VerticalAlignment="Center">
              <Run Text="Counter" Foreground="#36D6E7"/><Run Text="Play" Foreground="#FF5A4D"/>
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="SettingsBtn" Content="⚙" Click="OnSettings"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#C89B3C" FontSize="15" Padding="6,0"
                    Cursor="Hand" ToolTip="{loc:T settings.title}"/>
            <Button x:Name="PinBtn" Content="📌" Click="OnPin"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#C89B3C" FontSize="14" Padding="6,0"
                    Cursor="Hand" ToolTip="{loc:T tip.pin}"/>
            <Button x:Name="TrayBtn" Content="—" Click="OnMinimize"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#C89B3C" FontSize="15" Padding="6,0"
                    Cursor="Hand" ToolTip="{loc:T tip.tray}"/>
            <Button Content="✕" Click="OnQuit"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#507090" FontSize="12" Padding="6,0"
                    Cursor="Hand"/>
          </StackPanel>
        </Grid>

        <!-- ── Статус + подсказка по порядку пика ────────────────────── -->
        <StackPanel Grid.Row="1" Margin="12,5,12,8">
          <TextBlock x:Name="StatusText" Text="{loc:T status.waitClient}"
                     FontFamily="{StaticResource UiFont}" FontSize="11"
                     Foreground="#5A7A90"/>
          <TextBlock x:Name="PickHint" Visibility="Collapsed"
                     FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="Bold"
                     Foreground="#E8B84B" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══ ЭКРАН ОЖИДАНИЯ ════════════════════════════════════════ -->
        <!-- Grid, а не StackPanel: так вложенный ScrollViewer получает
             ограничение по высоте строки и прокручивается вместо обрезки. -->
        <Grid Grid.Row="2" x:Name="IdlePanel" Visibility="Collapsed"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Margin="24,10,24,14">

          <!-- ── Стадия загрузки/ожидания: точки + крупный статус + прогресс ── -->
          <StackPanel x:Name="LoadingInfo">
            <!-- Три точки, поочередно медленно мигающие -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
              <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                                       From="1.0" To="0.2" Duration="0:0:0.7" AutoReverse="True"
                                       BeginTime="0:0:0.0"/>
                      <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                                       From="1.0" To="0.2" Duration="0:0:0.7" AutoReverse="True"
                                       BeginTime="0:0:0.4"/>
                      <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                                       From="1.0" To="0.2" Duration="0:0:0.7" AutoReverse="True"
                                       BeginTime="0:0:0.8"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </StackPanel.Triggers>
              <Ellipse x:Name="Dot1" Width="12" Height="12" Fill="#C89B3C" Opacity="0.2" Margin="5,0"/>
              <Ellipse x:Name="Dot2" Width="12" Height="12" Fill="#C89B3C" Opacity="0.2" Margin="5,0"/>
              <Ellipse x:Name="Dot3" Width="12" Height="12" Fill="#C89B3C" Opacity="0.2" Margin="5,0"/>
            </StackPanel>

            <!-- Крупная подпись текущей стадии -->
            <TextBlock x:Name="IdleStatusText" Text="{loc:T status.waitClient}"
                       FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"
                       Foreground="#E8E0CC" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="300"/>

            <!-- Полоса прогресса загрузки (обновление/база) -->
            <Grid x:Name="DlBar" Width="260" Height="8" Margin="0,14,0,0"
                  Visibility="Collapsed" ClipToBounds="True">
              <Border Background="#1AFFFFFF" CornerRadius="4"/>
              <Border x:Name="DlBarFill" HorizontalAlignment="Left" Width="0"
                      Background="#C89B3C" CornerRadius="4"/>
              <!-- Скользящий блик: бар «живой» даже когда % замер на распаковке -->
              <Border x:Name="DlBarPulse" HorizontalAlignment="Left" Width="70"
                      CornerRadius="4" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                  <TranslateTransform x:Name="DlBarPulseT" X="-70"/>
                </Border.RenderTransform>
              </Border>
            </Grid>
          </StackPanel>

          <!-- ── Готов: трекер сессии (ранг/LP/последние игры/винрейт) + советы ── -->
          <!-- Ready-экран БЕЗ прокрутки: окно просто вырастает под содержимое.
               Полоса прокрутки здесь мешала больше, чем лишние пиксели высоты. -->
          <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                        x:Name="ReadyScroll" Visibility="Collapsed">
            <StackPanel x:Name="ReadyInfo" MaxWidth="282">

            <!-- Эмблема ранга + ник с «крыльями» (в цвет ранга) и выбор очереди -->
            <Grid x:Name="RankCard">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <!-- Эмблема умеет вспыхивать при смене дивизиона: масштаб и свечение
                   задаются кодом, здесь только место под них. -->
              <Image x:Name="RankEmblem" Grid.Column="0" Height="74" HorizontalAlignment="Left"
                     Margin="-6,0,0,-4" Stretch="Uniform" Visibility="Collapsed"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform x:Name="RankEmblemScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="RankEmblemMove"/>
                  </TransformGroup>
                </Image.RenderTransform>
              </Image>
              <!-- Ранга не видно — ранговая очередь без отборочных, только нормалы
                   или данных ещё нет (только поставили программу): на месте
                   эмблемы — её силуэт скелетоном, с бегущим бликом. Заливка и
                   маска формы задаются кодом (Skeleton.Shimmer, золотая эмблема). -->
              <Rectangle x:Name="RankEmblemSkel" Grid.Column="0" Width="90" Height="74"
                         HorizontalAlignment="Left" Margin="-6,0,0,-4" Visibility="Collapsed"/>
              <!-- В очередях без ранга (нормалы, ARAM) на месте эмблемы — значок
                   карты, как в клиенте (QueueMapSource: три линии у Ущелья, одна
                   у Бездны), без рамки, со свечением своего цвета. Центр — где
                   центр эмблемы лиги; в компактной карточке размер и отступ
                   задаёт код вместе с эмблемой. -->
              <Grid x:Name="QueueMapBox" Grid.Column="0" Width="66" Height="66"
                    HorizontalAlignment="Left" Margin="13,4,0,0" Visibility="Collapsed">
                <Image x:Name="QueueMap" Width="60" Height="60" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Image.Effect>
                    <DropShadowEffect Color="#10E4F9" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                  </Image.Effect>
                </Image>
              </Grid>
              <!-- Сборка эмблемы при переходе в НОВУЮ ЛИГУ. Новый знак приезжает
                   сверху двумя половинами и сваривается посередине: луч, вспышка
                   и короткий скачок размера. Обе половины — одна и та же
                   картинка, разрезанная пополам обрезкой (задаётся в коде: она
                   зависит от того, какой ширины вышла эмблема). -->
              <Grid x:Name="RankWeld" Grid.Column="0" Height="74" HorizontalAlignment="Left"
                    Margin="-6,0,0,-4" Visibility="Collapsed" IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <ScaleTransform x:Name="RankWeldScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Image x:Name="RankHalfLeft" Height="74" Stretch="Uniform"
                       HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality">
                  <Image.RenderTransform>
                    <TranslateTransform x:Name="RankHalfLeftMove"/>
                  </Image.RenderTransform>
                </Image>
                <Image x:Name="RankHalfRight" Height="74" Stretch="Uniform"
                       HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality">
                  <Image.RenderTransform>
                    <TranslateTransform x:Name="RankHalfRightMove"/>
                  </Image.RenderTransform>
                </Image>
                <!-- Шов: вертикальный луч, яркий в середине и сходящий на нет к
                     краям. Ставится по центру эмблемы кодом. -->
                <Border x:Name="RankWeldBeam" Width="14" HorizontalAlignment="Left"
                        Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#00FFFFFF" Offset="0"/>
                      <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                      <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <Border.RenderTransform>
                    <ScaleTransform x:Name="RankWeldBeamScale" ScaleX="1" ScaleY="0.2"/>
                  </Border.RenderTransform>
                  <Border.Effect>
                    <DropShadowEffect x:Name="RankWeldGlow" Color="#FFF3C4" ShadowDepth="0"
                                      BlurRadius="0" Opacity="0"/>
                  </Border.Effect>
                </Border>
              </Grid>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                          Margin="0,2,2,0">
                <!-- Ник в обрамлении половинок ранговой эмблемы (левое/правое крыло) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                  <Image x:Name="WingLeft" Height="22" Stretch="Uniform"
                         VerticalAlignment="Center" Margin="0,0,5,9" Visibility="Collapsed"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock x:Name="NickText" Text=""
                             FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Bold"
                             Foreground="#E6EDF3" TextTrimming="CharacterEllipsis" MaxWidth="130"
                             VerticalAlignment="Center"/>
                  <Image x:Name="WingRight" Height="22" Stretch="Uniform"
                         VerticalAlignment="Center" Margin="5,0,0,9" Visibility="Collapsed"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>
                <!-- Очередь: кнопка-чип с выпадающим списком (стата по очередям) -->
                <Border x:Name="QueueChip" HorizontalAlignment="Right" Margin="0,6,0,0"
                        CornerRadius="4" BorderBrush="#557089" BorderThickness="1"
                        Background="#1AFFFFFF" Padding="9,2,9,3" Cursor="Hand"
                        MouseLeftButtonDown="QueueChip_Click">
                  <TextBlock x:Name="QueueText" Text=""
                             FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"
                             Foreground="#C9D2DC"/>
                </Border>
              </StackPanel>
            </Grid>

            <!-- Ранг · LP · полоса прогресса до след. ранга -->
            <Grid Margin="0,2,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="RankText" Grid.Column="0" Text="—"
                         FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="Bold"
                         Foreground="#E6EDF3" VerticalAlignment="Bottom"/>
              <!-- Пока цифры перещёлкиваются, надпись подрастает. Точка отсчёта —
                   правый край: слева от неё название ранга, и растягиваться туда
                   надписи некуда. -->
              <TextBlock x:Name="RankLpText" Grid.Column="1" Text=""
                         FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="Bold"
                         Foreground="#9FB3C8" VerticalAlignment="Bottom" Margin="0,0,0,2"
                         RenderTransformOrigin="1,0.5">
                <TextBlock.RenderTransform>
                  <ScaleTransform x:Name="RankLpScale" ScaleX="1" ScaleY="1"/>
                </TextBlock.RenderTransform>
              </TextBlock>
              <!-- Скелетоны ранга и LP (показываются, пока данных нет) -->
              <Border x:Name="RankSkel" Grid.Column="0" Width="132" Height="20" CornerRadius="4"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed"/>
              <Border x:Name="RankLpSkel" Grid.Column="1" Width="46" Height="13" CornerRadius="3"
                      VerticalAlignment="Bottom" Margin="0,0,0,4" Visibility="Collapsed"/>
            </Grid>
            <!-- Засечки над полосой: сколько игр осталось до перехода. Появляются
                 только у краёв (близко к повышению или к понижению) — в середине
                 шкалы считать нечего, а лишние чёрточки там только мешают. -->
            <Canvas x:Name="RankTicks" Height="5" Margin="0,0,0,2" ClipToBounds="False"/>
            <!-- Полоса LP. Поверх заполненной части — штриховка на ширину одной
                 победы: сколько очков принесёт следующая игра. -->
            <Border x:Name="RankProgressTrack" Height="7" CornerRadius="4"
                    Background="#22FFFFFF" ClipToBounds="True">
              <Grid>
                <Border x:Name="RankProgressFill" Width="0" Height="7" CornerRadius="4"
                        HorizontalAlignment="Left">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#2E7DD1" Offset="0"/>
                      <GradientStop Color="#36D6E7" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <!-- Штриховка того же цвета, но полупрозрачная: это ещё не
                     набранные очки, и выглядеть как набранные они не должны. -->
                <!-- Две штриховки: ближняя игра и следующая за ней. Вторая
                     бледнее — она дальше и менее определённа. Край, примыкающий
                     к соседней части, прямой: скруглённый читался бы как разрыв. -->
                <Border x:Name="RankProgressGhost2" Width="0" Height="7" CornerRadius="0,4,4,0"
                        HorizontalAlignment="Left" Visibility="Collapsed" Opacity="0.45"
                        Background="{StaticResource LpGhostHatch}"/>
                <Border x:Name="RankProgressGhost" Width="0" Height="7" CornerRadius="0,4,4,0"
                        HorizontalAlignment="Left" Visibility="Collapsed"
                        Background="{StaticResource LpGhostHatch}"/>
              </Grid>
            </Border>

            <!-- Последние 5 игр: иконки во всю ширину бара + LP за игру -->
            <Grid x:Name="Last5Panel" Margin="0,12,0,0"/>

            <!-- Подсказка: статистика наполняется по мере сыгранных игр -->
            <!-- Крупнее и контрастнее обычной подписи: на пустом экране это
                 единственное объяснение, почему статистики ещё нет. -->
            <TextBlock x:Name="SessionHint" Visibility="Collapsed"
                       FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="Bold"
                       Foreground="#C3D3E0" TextWrapping="Wrap" LineHeight="18"
                       TextAlignment="Center" Margin="0,10,0,0"/>

            <!-- Винрейт слева (W–L мелко, % крупно с цветом) + график справа -->
            <Grid x:Name="WinrateRow" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="SeasonWlText" FontFamily="{StaticResource UiFont}"
                           FontSize="12" FontWeight="Bold" Foreground="#9FB3C8"/>
                <TextBlock x:Name="WinrateBig" Text="—"
                           FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold"
                           Foreground="#E6EDF3" Margin="0,-4,0,0"/>
              </StackPanel>
              <!-- Скелетоны W–L и крупного винрейта -->
              <StackPanel x:Name="WinrateSkel" Grid.Column="0" VerticalAlignment="Center"
                          Visibility="Collapsed">
                <Border Width="66" Height="11" CornerRadius="3" HorizontalAlignment="Left"
                        Background="{x:Null}" x:Name="WlSkelBar"/>
                <Border Width="86" Height="34" CornerRadius="5" HorizontalAlignment="Left"
                        Margin="0,6,0,0" x:Name="WrSkelBar"/>
              </StackPanel>
              <Canvas x:Name="WrChart" Grid.Column="1" Height="66" Margin="10,2,0,0"
                      ClipToBounds="True"/>
            </Grid>

            <!-- Подбор выключен в настройках: занимает место блока пула -->
            <Border x:Name="DraftOffNotice" Visibility="Collapsed"
                    Margin="0,12,0,0" Width="282" CornerRadius="7"
                    Background="#14FFFFFF" BorderBrush="#3336D6E7" BorderThickness="1"
                    Padding="12,10">
              <TextBlock Text="{loc:T ready.draftOff}"
                         FontFamily="{StaticResource UiFont}" FontSize="12"
                         Foreground="#C3D3E0" TextWrapping="Wrap" LineHeight="16"
                         TextAlignment="Center"/>
            </Border>

            <!-- Пул чемпионов: заголовок + имя выбранной связки рядом -->
            <StackPanel x:Name="PoolTitleRow" Orientation="Horizontal" Margin="0,12,0,6" HorizontalAlignment="Left">
              <TextBlock Text="{loc:T pool.sectionTitle}"
                         FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="Bold"
                         Foreground="#8AA0B2" VerticalAlignment="Center"/>
              <TextBlock x:Name="PoolActiveName" Visibility="Collapsed"
                         FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="Bold"
                         Foreground="#C89B3C" VerticalAlignment="Center" Margin="6,0,0,0"
                         MaxWidth="165" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Кнопки режима и полоса чемпионов — в одной ячейке с подсказкой
                 режима пула (OverlayWindow.PoolHint.cs): она встаёт поверх них, а
                 не сдвигает панель. Ячейка по высоте — по кнопкам с полосой. -->
            <Grid x:Name="PoolArea">
              <StackPanel x:Name="PoolUnder">
                <!-- Режимы (Настройки · Обычный · Пул · Дуо) — во всю ширину панели -->
                <UniformGrid x:Name="PoolButtonsRow" Columns="4">
                  <UniformGrid.Resources>
                    <Style TargetType="Button">
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderBrush" Value="#405060"/>
                      <Setter Property="BorderThickness" Value="1"/>
                      <Setter Property="Foreground" Value="#9FB3C8"/>
                      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                      <Setter Property="FontSize" Value="12"/>
                      <Setter Property="FontWeight" Value="Bold"/>
                      <Setter Property="Padding" Value="2,8"/>
                      <Setter Property="Margin" Value="2,0"/>
                      <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                  </UniformGrid.Resources>
                  <!-- Настройки — золотом, как кнопки на сайте -->
                  <Button x:Name="PoolSettingsBtn" Click="PoolSettings_Click"
                          Content="{loc:T pool.settings}"
                          Foreground="#C89B3C" BorderBrush="#8A6D2F" Background="#18C89B3C"/>
                  <Button x:Name="PoolNormalBtn" Click="PoolNormal_Click" Content="{loc:T pool.normal}"/>
                  <Button x:Name="PoolPoolBtn" Click="PoolPool_Click" Content="{loc:T pool.pool}"/>
                  <Button x:Name="PoolDuoBtn" Click="PoolDuo_Click" Content="{loc:T pool.duo}"/>
                </UniformGrid>

                <!-- Мои чемпионы за 30 дней: одна строка ровно по ширине ряда кнопок
                     пула (UniformGrid на то же число колонок, что и карточек). -->
                <StackPanel x:Name="MyChampsBox" Visibility="Collapsed" Margin="0,7,0,0">
                  <TextBlock Text="{loc:T pool.myChamps30d}" Margin="4,0,2,3"
                             FontFamily="{StaticResource UiFont}" FontSize="10" FontWeight="Bold"
                             Foreground="#6E8AA0" HorizontalAlignment="Left"/>
                <ItemsControl x:Name="MyChampsStrip" Height="52">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" Columns="6"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- Margin как у кнопок пула (2,0) — края строк совпадают -->
                      <Border Margin="2,0" CornerRadius="6" BorderThickness="1" Padding="3,2"
                              BorderBrush="{Binding Frame}" Background="{Binding Tint}" ToolTip="{Binding Tip}">
                        <StackPanel>
                          <!-- Fill — иконка чемпиона либо ровная заливка пустого слота -->
                          <Border Width="30" Height="30" CornerRadius="4" HorizontalAlignment="Center"
                                  Background="{Binding Fill}"/>
                          <Grid Margin="0,2,0,0" Height="11">
                            <TextBlock Text="{Binding Wr}" Foreground="{Binding Frame}" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource UiFont}" FontSize="9" FontWeight="Bold"/>
                            <!-- Скелетон вместо цифр, пока игр по чемпиону нет -->
                            <Border Width="22" Height="8" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{Binding Fill}" Visibility="{Binding WrSkeleton}"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
              </StackPanel>

              <!-- Подсказка режима пула: в лобби с напарником — включить дуо-пул,
                   одному — выключить его. Непрозрачная: кнопки под ней не должны
                   просвечивать. Свечение — отдельным слоем позади: эффект на
                   самой карточке размыл бы текст. Рамка яркая и толще кнопок:
                   карточку должно быть видно сразу (владелец 15.10). Появляется
                   с бликом и вспышкой свечения, внизу — полоса ожидания: 15 с,
                   курсор над карточкой её держит. Тексты и значок ставит код. -->
              <Grid x:Name="PoolHintCard" Visibility="Collapsed" Opacity="0" Margin="2,0"
                    MouseEnter="PoolHint_MouseEnter" MouseLeave="PoolHint_MouseLeave">
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="PoolHintMove"/>
                </Grid.RenderTransform>
                <Border CornerRadius="8" Background="#0C1726">
                  <Border.Effect>
                    <DropShadowEffect x:Name="PoolHintGlow" Color="#4FB3FF" BlurRadius="22"
                                      ShadowDepth="0" Opacity="0.55"/>
                  </Border.Effect>
                </Border>
                <Border CornerRadius="8" BorderThickness="1.5">
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#9AD3FF" Offset="0"/>
                      <GradientStop Color="#4F9DFF" Offset="0.5"/>
                      <GradientStop Color="#3FE0F0" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#18294A" Offset="0"/>
                      <GradientStop Color="#0C1726" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <!-- Внутренний слой обрезается по скруглению (кодом): блик и
                       полоса ожидания не вылезают за углы рамки. -->
                  <Grid x:Name="PoolHintInner" SizeChanged="PoolHintInner_SizeChanged">
                    <Grid Margin="11,8,10,11">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <Path x:Name="PoolHintIcon" Width="17" Height="14" Stretch="Uniform"
                              Fill="#8CCBFF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="PoolHintTitle" MaxWidth="225" TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="Bold"
                                   Foreground="#E6EDF3" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock x:Name="PoolHintText" Grid.Row="1" Margin="0,3,0,0"
                                 FontFamily="{StaticResource UiFont}" FontSize="12"
                                 Foreground="#C3D3E0" TextWrapping="Wrap" LineHeight="16"/>
                      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                  Margin="0,7,0,0">
                        <Button x:Name="PoolHintLaterBtn" Click="PoolHintLater_Click"
                                Content="{loc:T poolHint.later}"
                                Background="Transparent" BorderThickness="1" BorderBrush="#405060"
                                Foreground="#9FB3C8" FontFamily="{StaticResource UiFont}" FontSize="11"
                                FontWeight="Bold" Padding="10,3" Cursor="Hand"/>
                        <!-- Как подсвеченная кнопка режима: нажатие делает её такой же. -->
                        <Button x:Name="PoolHintApplyBtn" Click="PoolHintApply_Click" Margin="6,0,0,0"
                                Background="#223655" BorderThickness="1" BorderBrush="#5A8AC8"
                                Foreground="White" FontFamily="{StaticResource UiFont}" FontSize="11"
                                FontWeight="Bold" Padding="12,3" Cursor="Hand"/>
                      </StackPanel>
                    </Grid>
                    <!-- Блик: светлая косая полоса, пробегает один раз при появлении. -->
                    <Rectangle x:Name="PoolHintShine" Width="70" HorizontalAlignment="Left"
                               IsHitTestVisible="False" Opacity="0">
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                          <GradientStop Color="#00FFFFFF" Offset="0"/>
                          <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                          <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                      </Rectangle.Fill>
                      <Rectangle.RenderTransform>
                        <TransformGroup>
                          <SkewTransform AngleX="-20"/>
                          <TranslateTransform x:Name="PoolHintShineMove" X="-90"/>
                        </TransformGroup>
                      </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Полоса ожидания: тает справа налево; кончилась — карточка
                         уходит, как по «Не сейчас». -->
                    <Border Height="3" VerticalAlignment="Bottom" Background="#18FFFFFF"
                            IsHitTestVisible="False"/>
                    <Border x:Name="PoolHintTimer" Height="3" VerticalAlignment="Bottom"
                            IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#4F9DFF" Offset="0"/>
                          <GradientStop Color="#3FE0F0" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                      <Border.RenderTransform>
                        <ScaleTransform x:Name="PoolHintTimerScale" ScaleX="1"/>
                      </Border.RenderTransform>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </Grid>

            <!-- Тестовый режим: «Сохранить для драфта» + копирование журнала.
                 Обе кнопки включаются кодом, в боевом режиме их нет. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Button x:Name="SaveForDraftBtn" Click="SaveForDraft_Click" Visibility="Collapsed"
                      Cursor="Hand" Margin="0,0,6,0"
                      Background="#335A8AC8" BorderBrush="#5A8AC8" BorderThickness="1"
                      Foreground="White" FontFamily="{StaticResource UiFont}" FontSize="11"
                      FontWeight="Bold" Padding="12,4"/>
              <Button x:Name="CopyLogBtn" Click="CopyLog_Click" Visibility="Collapsed"
                      Cursor="Hand" Content="📋 Логи"
                      ToolTip="Скопировать последние 100 строк журнала в буфер обмена"
                      Background="#33C89B3C" BorderBrush="#8A6D2F" BorderThickness="1"
                      Foreground="#F5D77A" FontFamily="{StaticResource UiFont}" FontSize="11"
                      FontWeight="Bold" Padding="12,4"/>
            </StackPanel>

            <!-- Карусель советов (временно скрыта на время беты — вернём позже):
            <Border Margin="0,15,0,0" Width="282" Height="118" CornerRadius="7"
                    Background="#14FFFFFF" BorderBrush="#33C89B3C" BorderThickness="1"
                    Padding="13,10">
              <StackPanel>
                <TextBlock Text="{loc:T ready.tipLabel}" FontFamily="{StaticResource UiFont}"
                           FontSize="10" FontWeight="Bold" Foreground="#C89B3C"
                           Opacity="0.8" Margin="0,0,0,6"/>
                <TextBlock x:Name="TipText" FontFamily="{StaticResource UiFont}" FontSize="12"
                           Foreground="#D7DEE6" TextWrapping="Wrap" LineHeight="16"/>
              </StackPanel>
            </Border>
            -->

            <!-- Разовое уведомление об автозапуске (после обновления, один раз) -->
            <Border x:Name="AutostartNotice" Visibility="Collapsed"
                    Margin="0,14,0,0" Width="282" CornerRadius="7"
                    Background="#14FFFFFF" BorderBrush="#3336D6E7" BorderThickness="1"
                    Padding="12,10">
              <StackPanel>
                <TextBlock x:Name="AutostartNoticeText"
                           FontFamily="{StaticResource UiFont}" FontSize="11"
                           Foreground="#D7DEE6" TextWrapping="Wrap" LineHeight="15"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                  <Button x:Name="AutostartOffBtn" Click="AutostartOff_Click"
                          Background="Transparent" BorderThickness="1" BorderBrush="#557089"
                          Foreground="#C9D2DC" FontSize="11" Padding="9,3" Cursor="Hand"/>
                  <Button x:Name="AutostartOkBtn" Click="AutostartOk_Click" Margin="7,0,0,0"
                          Background="#2236D6E7" BorderThickness="0"
                          Foreground="#E6EDF3" FontSize="11" FontWeight="Bold"
                          Padding="11,3" Cursor="Hand"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Фаза, в которой находится окно — крупно, над плашкой беты -->
            <TextBlock x:Name="ReadyStatusText" Text="Готов"
                       FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="Bold"
                       Foreground="#C89B3C" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>

            <!-- Плашка беты: светящаяся надпись + просьба писать в поддержку -->
            <Border x:Name="BetaCard" Margin="0,11,0,0" Width="282" CornerRadius="7"
                    Background="#14FFFFFF" BorderBrush="#33C89B3C" BorderThickness="1"
                    Padding="13,10">
              <StackPanel>
                <!-- Заголовок плашки и два его знака по бокам: у неполадки —
                     красный треугольник с восклицательным знаком, у остальных
                     свой (искра у новости, синий треугольник у важного, лампа у
                     совета, стрелка у обновления). Форму и цвет ставит код, здесь
                     только места под них.
                     Знаки нарисованы вектором, а не символами шрифта: у системных
                     шрифтов их может не оказаться, и вместо предупреждения игрок
                     увидел бы пустой квадрат. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,7">
                  <Grid x:Name="BetaWarnLeft" Width="21" Height="19" Margin="0,0,8,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <Path x:Name="BetaMarkLeft" Data="M10.5,0.8 L20.4,18 L0.6,18 Z" Fill="#FF4438"
                          Stroke="#FFE8E6" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                    <TextBlock x:Name="BetaBangLeft" Text="!" Foreground="#FFFFFF"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="0,4,0,0"/>
                  </Grid>
                  <TextBlock x:Name="BetaBadge" Text="BETA" VerticalAlignment="Center"
                             FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="Bold"
                             Foreground="#FFE066">
                    <TextBlock.Effect>
                      <DropShadowEffect x:Name="BetaGlow" Color="#FFD75A" ShadowDepth="0"
                                        BlurRadius="16" Opacity="0.95"/>
                    </TextBlock.Effect>
                  </TextBlock>
                  <Grid x:Name="BetaWarnRight" Width="21" Height="19" Margin="8,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <Path x:Name="BetaMarkRight" Data="M10.5,0.8 L20.4,18 L0.6,18 Z" Fill="#FF4438"
                          Stroke="#FFE8E6" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                    <TextBlock x:Name="BetaBangRight" Text="!" Foreground="#FFFFFF"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="0,4,0,0"/>
                  </Grid>
                </StackPanel>
                <TextBlock x:Name="BetaText" Text="{loc:T ready.beta}"
                           FontFamily="{StaticResource UiFont}" FontSize="12"
                           Foreground="#D7DEE6" TextWrapping="Wrap" LineHeight="16"
                           TextAlignment="Center"/>
                <TextBlock x:Name="BetaLinkLine" TextAlignment="Center" Margin="0,4,0,0"
                           FontFamily="{StaticResource UiFont}" FontSize="12">
                  <Hyperlink x:Name="BetaLink" NavigateUri="https://counterplays.com/support"
                             RequestNavigate="OpenLink" Foreground="#36D6E7"
                             TextDecorations="Underline" Cursor="Hand"><Run x:Name="BetaLinkText"
                             Text="counterplays.com/support"/></Hyperlink>
                </TextBlock>
              </StackPanel>
            </Border>

          </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ══ КОМПАКТНЫЙ ВИД ════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" x:Name="CompactScroll" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Hidden" Margin="12,0,12,8">
          <ItemsControl x:Name="RecList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,3" Padding="8,7" CornerRadius="4" Background="#28C89B3C">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/>
                      <ColumnDefinition Width="46"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Rank}" Foreground="#C89B3C"
                               FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Ellipse Grid.Column="1" Width="36" Height="36"
                             Margin="0,0,8,0" VerticalAlignment="Center">
                      <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                      </Ellipse.Fill>
                      <Ellipse.Stroke><SolidColorBrush Color="#C89B3C"/></Ellipse.Stroke>
                      <Ellipse.StrokeThickness>1.5</Ellipse.StrokeThickness>
                    </Ellipse>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Foreground="White"
                                 FontFamily="{StaticResource UiFont}"
                                 FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Reason}" Foreground="#5A7A90"
                                 FontFamily="{StaticResource UiFont}" FontSize="10.5"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Score}"
                               Foreground="{Binding ScoreColor}"
                               FontFamily="{StaticResource UiFont}" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- ══ ПОЛНЫЙ ВИД ════════════════════════════════════════════ -->
        <Grid Grid.Row="2" x:Name="FullView" Visibility="Collapsed" Margin="12,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="282"/>  <!-- Моя команда — статичная ширина пиков -->
            <ColumnDefinition Width="*"/>    <!-- Рекомендации — забирают остаток       -->
            <ColumnDefinition Width="282"/>  <!-- Враги — статичная ширина пиков         -->
          </Grid.ColumnDefinitions>

          <!-- МОЯ КОМАНДА ─────────────────────────────────────────── -->
          <DockPanel x:Name="MyTeamPanel" Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top"
                       Text="{loc:T team.myTeam}"
                       FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold"
                       Foreground="#C89B3C" Margin="0,0,0,2"/>
            <TextBlock DockPanel.Dock="Top" x:Name="MyTeamStyle" Text=""
                       FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="Bold"
                       Foreground="#8AA0B2" Margin="0,0,0,10"/>

            <!-- Баланс урона команды: AD (красный) / AP (синий) / чистый (белый) -->
            <StackPanel DockPanel.Dock="Bottom" x:Name="MyDmgPanel" Visibility="Collapsed"
                        Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{loc:T team.damage}"
                           FontFamily="{StaticResource UiFont}" FontSize="9" FontWeight="Bold"
                           Foreground="#8AA0B2"/>
                <!-- Чего команде не хватает. Показывается только при сильном перекосе. -->
                <TextBlock x:Name="MyDmgWarn" Visibility="Collapsed" Margin="8,0,0,0"
                           FontFamily="{StaticResource UiFont}" FontSize="9" FontWeight="Bold"
                           Foreground="#F5C24A"/>
              </StackPanel>
              <Border x:Name="MyDmgBar" Height="9" CornerRadius="4" Background="#22FFFFFF" ClipToBounds="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MyDmgAdCol"/>
                    <ColumnDefinition x:Name="MyDmgApCol"/>
                    <ColumnDefinition x:Name="MyDmgTrueCol"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#E05050"/>
                  <Border Grid.Column="1" Background="#4A9EFF"/>
                  <Border Grid.Column="2" Background="#E8EEF5"/>
                </Grid>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="MyDmgAdText" Foreground="#E05050" FontFamily="{StaticResource UiFont}"
                           FontSize="10" FontWeight="Bold" Margin="0,0,9,0"/>
                <TextBlock x:Name="MyDmgApText" Foreground="#4A9EFF" FontFamily="{StaticResource UiFont}"
                           FontSize="10" FontWeight="Bold" Margin="0,0,9,0"/>
                <TextBlock x:Name="MyDmgTrueText" Foreground="#E8EEF5" FontFamily="{StaticResource UiFont}"
                           FontSize="10" FontWeight="Bold"/>
              </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="TeamScroll" VerticalScrollBarVisibility="Hidden"
                          ScrollChanged="TeamScroll_Changed">
              <StackPanel>
              <Grid>
              <ItemsControl x:Name="MyTeamList">
                <ItemsControl.ItemTemplate><StaticResource ResourceKey="TeamSlotTemplate"/></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Canvas x:Name="MyTeamLines" IsHitTestVisible="False"/>
              </Grid>

              <TextBlock x:Name="MyCombosHeader" Text="{loc:T team.combos}" Visibility="Collapsed"
                         FontFamily="{StaticResource UiFont}" FontSize="10" FontWeight="Bold"
                         Foreground="#C89B3C" Margin="0,14,0,0"/>
              <ItemsControl x:Name="MyTeamCombos"
                            ItemTemplate="{StaticResource ComboTemplate}"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <!-- РЕКОМЕНДАЦИИ ──────────────────────────────────────────── -->
          <Border Grid.Column="1"
                  BorderBrush="#30C89B3C" BorderThickness="1,0"
                  Padding="10,0">
            <Grid x:Name="CenterGrid">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>     <!-- список пиков/банов -->
              <RowDefinition Height="Auto"/>  <!-- руны и билд        -->
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="RecScroll" Grid.Row="0" VerticalScrollBarVisibility="Hidden">
              <ItemsControl x:Name="FullRecList">
                <ItemsControl.ItemTemplate><StaticResource ResourceKey="PickCardTemplate"/></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Список банов (фаза банов) — в том же центре, переключается с пиками -->
            <ScrollViewer x:Name="BanScroll" Grid.Row="0" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
              <ItemsControl x:Name="BanFullList">
                <ItemsControl.ItemTemplate><StaticResource ResourceKey="BanCardTemplate"/></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Баны команд — фаза банов, когда свой бан уже сделан. Советовать
                 больше нечего: показываем, кого забанили обе команды и как часто
                 этих чемпионов банят в патче. Сверху наши, снизу враги; вражеские
                 клиент раскрывает только с концом таймера банов. -->
            <Border x:Name="BansDonePanel" Grid.Row="0" Visibility="Collapsed"
                    Margin="0,6,0,0" Padding="14,12" CornerRadius="8"
                    Background="#14FFFFFF" BorderBrush="#2A3A4F" BorderThickness="1">
              <StackPanel>
                <TextBlock x:Name="BansDoneTitle" Text="" Margin="0,0,0,10"
                           FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold"
                           Foreground="#C89B3C"/>
                <!-- До раскрытия вражеских банов видна только наша половина, и
                     стоит она по центру панели (сдвиг вниз — из кода). Раскрылись
                     — наша поднимается на место, их пять разом выезжают снизу.
                     Место под обе половины держится всегда: тир-лист под панелью
                     не прыгает. -->
                <Grid x:Name="BansOurHalf">
                  <StackPanel>
                    <TextBlock Text="{loc:T ban.ours}" Margin="0,0,0,6"
                               FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"
                               Foreground="#36D6E7"/>
                    <ItemsControl x:Name="BansOurList" ItemTemplate="{StaticResource BanSlot}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>
                </Grid>
                <Border x:Name="BansDoneSep" Height="1" Background="#22415568" Margin="0,12,0,10"/>
                <Grid x:Name="BansTheirHalf">
                  <StackPanel>
                    <TextBlock Text="{loc:T ban.theirs}" Margin="0,0,0,6"
                               FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"
                               Foreground="#FF5A4D"/>
                    <ItemsControl x:Name="BansTheirList" ItemTemplate="{StaticResource BanSlot}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Мои чемпионы — фаза объявления (15 с до банов): на ком я играл
                 ВЫДАННУЮ роль за месяц. Строка: винрейт и игры, форма (последние
                 игры квадратиками, новые справа), LP за месяц, винрейт в патче
                 со сдвигом к прошлому, метка «банят N%», если банят часто. Клик
                 показывает чемпиона союзникам (наведение пика в клиенте). Игр на
                 роли нет — чемпионы пула на неё без своих чисел. Ширины столбцов
                 общие у заголовка и строк. -->
            <Border x:Name="PlanPanel" Grid.Row="0" Visibility="Collapsed"
                    Margin="0,6,0,0" Padding="12,10" CornerRadius="8"
                    Background="#14FFFFFF" BorderBrush="#2A3A4F" BorderThickness="1">
              <StackPanel>
                <DockPanel Margin="2,0,0,8" LastChildFill="True">
                  <TextBlock x:Name="PlanHint" DockPanel.Dock="Right" Text="{loc:T plan.hint}"
                             VerticalAlignment="Center" Margin="10,0,0,0"
                             FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="#6E8598"/>
                  <TextBlock x:Name="PlanTitle" Text="" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold"
                             Foreground="#C89B3C"/>
                </DockPanel>
                <Grid x:Name="PlanHeader" Margin="10,0,10,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="110"/>
                  </Grid.ColumnDefinitions>
                  <Grid.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                      <Setter Property="FontSize" Value="10"/>
                      <Setter Property="Foreground" Value="#6E8598"/>
                    </Style>
                  </Grid.Resources>
                  <TextBlock Grid.Column="1" x:Name="PlanColGames" Text="{loc:T plan.colGames}"/>
                  <TextBlock Grid.Column="2" Text="{loc:T plan.colForm}"/>
                  <TextBlock Grid.Column="3" Text="LP"/>
                  <TextBlock Grid.Column="4" x:Name="PlanColPatch" Text=""/>
                </Grid>
                <ItemsControl x:Name="PlanList">
                  <ItemsControl.ItemTemplate><StaticResource ResourceKey="PlanCardTemplate"/></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="PlanEmpty" Visibility="Collapsed" Margin="2,4,0,2" TextWrapping="Wrap"
                           FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="#9AB2C6"/>
              </StackPanel>
            </Border>

            <!-- Заглушка центра: драфт идёт, а показать в центре пока нечего —
                 советы банов не посчитаны, подбор пуст, база не загружена. Две
                 плашки на месте будущих разделов (сверху советы, снизу тир-лист),
                 рамки как у настоящих панелей. Занимает обе строки центра; блик —
                 общая кисть Skeleton.Shimmer, ставится из кода. -->
            <Grid x:Name="CenterSkeleton" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
              </Grid.RowDefinitions>
              <Border x:Name="CenterSkelTop" Grid.Row="0" Margin="0,6,0,0"
                      CornerRadius="8" BorderBrush="#2A3A4F" BorderThickness="1"/>
              <Border x:Name="CenterSkelBottom" Grid.Row="1" Margin="0,12,0,8"
                      CornerRadius="8" BorderBrush="#2A3A4F" BorderThickness="1"/>
            </Grid>

            <!-- Кнопка выбора чемпиона: наведён кликом по карточке → лочим
                 в клиенте. Плавает над списком, показывается только в свой ход. -->
            <Border x:Name="PickBar" Grid.Row="0" VerticalAlignment="Bottom"
                    Visibility="Collapsed" Margin="0,0,0,4" CornerRadius="7"
                    Cursor="Hand" MouseLeftButtonDown="PickConfirm_Click"
                    Background="#1E7A2E" BorderBrush="#3FD16A" BorderThickness="1.5"
                    Padding="12,9">
              <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>
              </Border.Effect>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image x:Name="PickIcon" Width="22" Height="22" VerticalAlignment="Center"
                       Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="PickText" VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold"
                           Foreground="#EAFBEF"/>
                <!-- Бренд как в шапке: лого + Counter(синий)Play(красный) — чтобы
                     каждый пик через программу запоминался фирменными цветами -->
                <Border Width="1" Height="16" Background="#4DFFFFFF" Margin="12,0,12,0"/>
                <Image Source="{StaticResource BrandMark}" Width="18" Height="18"
                       VerticalAlignment="Center" Margin="0,0,6,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center">
                  <Run Text="Counter" Foreground="#36D6E7"/><Run Text="Play" Foreground="#FF5A4D"/>
                </TextBlock>
              </StackPanel>
            </Border>

            <!-- Кнопка бана: наведён кликом по карточке бана → банит в клиенте.
                 Красная, показывается только когда мой ход банить. -->
            <Border x:Name="BanBar" Grid.Row="0" VerticalAlignment="Bottom"
                    Visibility="Collapsed" Margin="0,0,0,4" CornerRadius="7"
                    Cursor="Hand" MouseLeftButtonDown="BanConfirm_Click"
                    Background="#7A1E1E" BorderBrush="#E0584F" BorderThickness="1.5"
                    Padding="12,9">
              <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>
              </Border.Effect>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image x:Name="BanIcon" Width="22" Height="22" VerticalAlignment="Center"
                       Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="BanText" VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold"
                           Foreground="#FBEAEA"/>
                <Border Width="1" Height="16" Background="#4DFFFFFF" Margin="12,0,12,0"/>
                <Image Source="{StaticResource BrandMark}" Width="18" Height="18"
                       VerticalAlignment="Center" Margin="0,0,6,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center">
                  <Run Text="Counter" Foreground="#36D6E7"/><Run Text="Play" Foreground="#FF5A4D"/>
                </TextBlock>
              </StackPanel>
            </Border>

            <!-- ══ ТИР-ЛИСТ ПАТЧА (под банами) ═══════════════════════════
                 Лучшие по винрейту чемпионы, разложенные по ролям. Высота
                 ограничена половиной центра — баны важнее, тир-лист их не
                 вытесняет; при нехватке места роли прокручиваются. -->
            <!-- Все чемпионы моей роли — пока пик не сделан (руны ещё не пришли).
                 Мелкие иконки в две строки, порядок как в тир-листе. -->
            <Border Grid.Row="1" x:Name="RolePoolBar" Visibility="Collapsed"
                    Margin="0,6,0,8" Padding="10,8" CornerRadius="8"
                    Background="#14FFFFFF" BorderBrush="#2A3A4F" BorderThickness="1">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,6">
                  <TextBlock x:Name="RolePoolTitle" Text=""
                             FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold"
                             Foreground="#C89B3C" VerticalAlignment="Center"/>
                  <!-- Показатели наведённого чемпиона — теми же цветами, что полоски -->
                  <TextBlock x:Name="RolePoolHint" Margin="10,0,0,0" VerticalAlignment="Center"
                             FontFamily="{StaticResource UiFont}" FontSize="11"/>
                </StackPanel>
                <!-- Две строки иконок; остальное — прокруткой, панель низкая -->
                <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="RolePoolList">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><StaticResource ResourceKey="RolePoolCellTemplate"/></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <Border Grid.Row="1" x:Name="TierListBar" Visibility="Collapsed"
                    Margin="0,6,0,8" Padding="10,8" CornerRadius="8"
                    Background="#14FFFFFF" BorderBrush="#2A3A4F" BorderThickness="1">

              <DockPanel>
                <!-- Заголовок и переключатель: «Пики» — тир и винрейт (кого
                     брать), «Баны» — кого чаще всего банят в патче. -->
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,7">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="TierModePicks" Tag="picks" CornerRadius="4,0,0,4"
                            BorderThickness="1" Padding="9,2,9,3" Cursor="Hand"
                            MouseLeftButtonDown="TierMode_Click">
                      <TextBlock x:Name="TierModePicksText" Text="{loc:T tier.modePicks}"
                                 FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border x:Name="TierModeBans" Tag="bans" CornerRadius="0,4,4,0"
                            BorderThickness="0,1,1,1" Padding="9,2,9,3" Cursor="Hand"
                            MouseLeftButtonDown="TierMode_Click">
                      <TextBlock x:Name="TierModeBansText" Text="{loc:T tier.modeBans}"
                                 FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="TierTitle" Text="" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold"
                             Foreground="#C89B3C"/>
                </DockPanel>
                <!-- Роли — колонками. Внутри каждой роли два столбца: слева Тир
                     (с грейдами), справа WR (без грейдов). Листается вниз —
                     ниже грейды B, C, D. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <Grid>
                  <!-- Режим «Баны»: на каждой роли один столбец — кого банят
                       чаще всего, под иконкой бан-рейт в патче. -->
                  <ItemsControl x:Name="BanTierList" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#22415568" BorderThickness="0,0,1,0" VerticalAlignment="Top">
                        <StackPanel HorizontalAlignment="Center">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Image Source="{Binding RoleIcon}" Width="22" Height="22" Margin="0,0,6,0"
                                   Opacity="0.95" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding RoleLabel}" Foreground="#9FB4C6"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                          <TextBlock Text="{loc:T tier.byBanRate}" HorizontalAlignment="Center" Margin="0,0,0,3"
                                     FontFamily="{StaticResource UiFont}" FontSize="9" FontWeight="Bold"
                                     Foreground="#B0584F"/>
                          <ItemsControl ItemsSource="{Binding TierCells}"
                                        ItemTemplate="{StaticResource TierEmblem}"/>
                        </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl x:Name="TierList">
                    <!-- 5 ролей равными долями на всю ширину: UniformGrid делит
                         область поровну, роли раздвигаются и заполняют место
                         справа, а не жмутся слева. -->
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <!-- Разделитель между ролями — тонкая линия справа. Ячейка
                             тянется на всю долю, содержимое центрируем. -->
                        <Border BorderBrush="#22415568" BorderThickness="0,0,1,0"
                                VerticalAlignment="Top">
                        <StackPanel HorizontalAlignment="Center">
                          <!-- Заголовок роли над парой столбцов -->
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Image Source="{Binding RoleIcon}" Width="22" Height="22" Margin="0,0,6,0"
                                   Opacity="0.95" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding RoleLabel}" Foreground="#9FB4C6"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Слева — тир (с грейдами) -->
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                              <TextBlock Text="{loc:T tier.byTier}" HorizontalAlignment="Center" Margin="0,0,0,3"
                                         FontFamily="{StaticResource UiFont}" FontSize="9" FontWeight="Bold"
                                         Foreground="#B08A38"/>
                              <ItemsControl ItemsSource="{Binding TierCells}"
                                            ItemTemplate="{StaticResource TierEmblem}"/>
                            </StackPanel>
                            <!-- Справа — по винрейту (без грейдов) -->
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                              <TextBlock Text="{loc:T tier.byWr}" HorizontalAlignment="Center" Margin="0,0,0,3"
                                         FontFamily="{StaticResource UiFont}" FontSize="9" FontWeight="Bold"
                                         Foreground="#5E7488"/>
                              <ItemsControl ItemsSource="{Binding WrCells}"
                                            ItemTemplate="{StaticResource TierEmblem}"/>
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  </Grid>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <!-- ══ РУНЫ И БИЛД ═══════════════════════════════════════════
                 В ЦЕНТРЕ, под списком: боковые колонки (связки команд) остаются
                 видны. Слева руны (2 сверху, 1 снизу + «Применить» правее неё),
                 справа три сборки — у каждой 6 слотов и своя кнопка экспорта. -->
            <!-- VerticalAlignment=Top: у пиков строка по содержимому и он не
                 нужен, а у драфта без роли нижняя строка — остаток, и без него
                 панель рун растягивалась бы до низа окна. -->
            <Border Grid.Row="1" x:Name="RunesBar" Visibility="Collapsed" VerticalAlignment="Top"
                    Margin="0,6,0,8" Padding="9,7" CornerRadius="8"
                    Background="#14FFFFFF" BorderBrush="#2A3A4F" BorderThickness="1">

              <StackPanel>
                <Grid Margin="2,0,2,6">
                  <TextBlock x:Name="RunesTitle" Text="" HorizontalAlignment="Left"
                             FontFamily="{StaticResource UiFont}" FontSize="10" FontWeight="Bold"
                             Foreground="#8AA0B2" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="RunesStatus" Text="" HorizontalAlignment="Right"
                             FontFamily="{StaticResource UiFont}" FontSize="10"
                             Foreground="#57C98A" Visibility="Collapsed"/>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- руны   -->
                    <ColumnDefinition Width="*"/>      <!-- сборки -->
                  </Grid.ColumnDefinitions>

                  <!-- РУНЫ: сетка 2x2, варианты и кнопка расставляются в коде под
                       число вариантов (1 → рядом, 2 → сверху + кнопка снизу,
                       3 → 2+1 + кнопка). Центрируем по вертикали относительно сборок. -->
                  <Grid Grid.Column="0" x:Name="RuneGrid" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ячейка кнопки «Применить» (позиция задаётся в коде) -->
                    <Grid x:Name="ApplyCell" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                          HorizontalAlignment="Center" Margin="0,0,6,6">
                      <Border x:Name="ApplyGlowRing" CornerRadius="8" Margin="-2"
                              Background="Transparent" BorderBrush="#5CE4F2" BorderThickness="2.5"
                              IsHitTestVisible="False" Opacity="0">
                        <Border.Effect>
                          <DropShadowEffect Color="#36D6E7" ShadowDepth="0" BlurRadius="20" Opacity="1"/>
                        </Border.Effect>
                      </Border>
                      <Border x:Name="ApplyRunesBtn" Padding="6,6" CornerRadius="7" Cursor="Hand"
                              HorizontalAlignment="Left" Width="104"
                              Background="#2236D6E7" BorderBrush="#5536D6E7" BorderThickness="1.5"
                              MouseLeftButtonDown="ApplyRunes_Click">
                        <TextBlock x:Name="ApplyRunesText" Text="" TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource UiFont}" FontSize="10" FontWeight="Bold"
                                   Foreground="#E6EDF3"/>
                      </Border>
                    </Grid>
                  </Grid>

                  <!-- СБОРКИ: 6 слотов у каждой. CORE — золотая рамка, докупки
                       тусклые. Центрируем по вертикали: одна сборка встаёт по оси Y. -->
                  <ItemsControl Grid.Column="1" x:Name="BuildList" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><StaticResource ResourceKey="BuildRowTemplate"/></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </StackPanel>
            </Border>
            </Grid>
          </Border>

          <!-- ВРАГИ ────────────────────────────────────────────────── -->
          <DockPanel x:Name="EnemyTeamPanel" Grid.Column="2" Margin="10,0,0,0">
            <TextBlock DockPanel.Dock="Top"
                       Text="{loc:T team.enemies}"
                       FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold"
                       Foreground="#C84040" Margin="0,0,0,2"/>
            <TextBlock DockPanel.Dock="Top" x:Name="EnemyTeamStyle" Text=""
                       FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="Bold"
                       Foreground="#C08080" Margin="0,0,0,10"/>

            <!-- Баланс урона команды врага -->
            <StackPanel DockPanel.Dock="Bottom" x:Name="EnemyDmgPanel" Visibility="Collapsed"
                        Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{loc:T team.damage}"
                           FontFamily="{StaticResource UiFont}" FontSize="9" FontWeight="Bold"
                           Foreground="#C08080"/>
                <!-- Чем закрываться от их урона. Как и у своей команды, только
                     вывод обратный: не «чего не хватает нам», а «что купить». -->
                <TextBlock x:Name="EnemyDmgWarn" Visibility="Collapsed" Margin="8,0,0,0"
                           FontFamily="{StaticResource UiFont}" FontSize="9" FontWeight="Bold"
                           Foreground="#F5C24A"/>
              </StackPanel>
              <Border x:Name="EnemyDmgBar" Height="9" CornerRadius="4" Background="#22FFFFFF" ClipToBounds="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EnemyDmgAdCol"/>
                    <ColumnDefinition x:Name="EnemyDmgApCol"/>
                    <ColumnDefinition x:Name="EnemyDmgTrueCol"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#E05050"/>
                  <Border Grid.Column="1" Background="#4A9EFF"/>
                  <Border Grid.Column="2" Background="#E8EEF5"/>
                </Grid>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="EnemyDmgAdText" Foreground="#E05050" FontFamily="{StaticResource UiFont}"
                           FontSize="10" FontWeight="Bold" Margin="0,0,9,0"/>
                <TextBlock x:Name="EnemyDmgApText" Foreground="#4A9EFF" FontFamily="{StaticResource UiFont}"
                           FontSize="10" FontWeight="Bold" Margin="0,0,9,0"/>
                <TextBlock x:Name="EnemyDmgTrueText" Foreground="#E8EEF5" FontFamily="{StaticResource UiFont}"
                           FontSize="10" FontWeight="Bold"/>
              </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Hidden">
              <StackPanel>
              <Grid>
              <ItemsControl x:Name="EnemyTeamList">
                <ItemsControl.ItemTemplate><StaticResource ResourceKey="TeamSlotTemplate"/></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Canvas x:Name="EnemyTeamLines" IsHitTestVisible="False"/>
              </Grid>

              <TextBlock x:Name="EnemyCombosHeader" Text="{loc:T team.enemyCombos}" Visibility="Collapsed"
                         FontFamily="{StaticResource UiFont}" FontSize="10" FontWeight="Bold"
                         Foreground="#C84040" Margin="0,14,0,0"/>
              <ItemsControl x:Name="EnemyTeamCombos"
                            ItemTemplate="{StaticResource ComboTemplate}"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <!-- Линии синергии: появляются при наведении на карточку пика -->
          <Canvas x:Name="SynLinks" Grid.Column="0" Grid.ColumnSpan="3"
                  IsHitTestVisible="False"/>
        </Grid>

        <!-- ══ РУНЫ И БИЛД ═══════════════════════════════════════════════
             Появляется, когда чемпион выбран и данные по нему есть. Слева —
             варианты страниц рун (кнопки), справа — экспорт билда в клиент. -->
        <!-- ── Дисклеймер (полный обязательный текст Riot) + версия ──── -->
        <StackPanel Grid.Row="3">
          <TextBlock x:Name="Disclaimer"
                   Text="Counterplay isn't endorsed by Riot Games and doesn't reflect the views or opinions of Riot Games or anyone officially involved in producing or managing Riot Games properties. Riot Games, and all associated properties are trademarks or registered trademarks of Riot Games, Inc."
                   Foreground="#33708090" FontFamily="{StaticResource UiFont}" FontSize="7.5"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Stretch" Margin="16,6,16,2"/>
          <!-- Версия программы; при готовом обновлении текст меняется и мигает -->
          <TextBlock x:Name="VersionText" Text="" Foreground="#4A6070"
                     FontFamily="{StaticResource UiFont}" FontSize="10"
                     TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Stretch" Margin="16,0,16,7"/>

          <!-- ── Что качается прямо сейчас ──────────────────────────────
               Две полосы под версией: база и новая версия программы. Обе
               качаются ФОНОМ — программа в это время работает, — и полосы
               здесь единственный способ об этом узнать. Каждая показывается
               сама по себе: качаться может и то, и другое, и оба сторожа
               рано или поздно совпадут.

               Полосы тонкие и без бегущего блика: это справка, а не событие,
               ради которого стоит отвлекаться от драфта. Подробности (скорость,
               что именно) — в подсказке при наведении, в строку они не лезут.

               Подписи «base» и «release» нарочно не переводятся: два коротких
               слова, понятных везде, а места на подпись ровно столько. -->
          <StackPanel x:Name="SideDlDb" Visibility="Collapsed" Margin="16,0,16,2">
            <DockPanel>
              <TextBlock Text="base" DockPanel.Dock="Left" Width="34"
                         Foreground="#4A6070" FontFamily="{StaticResource UiFont}"
                         FontSize="8" VerticalAlignment="Center"/>
              <TextBlock x:Name="SideDlDbPct" Text="" DockPanel.Dock="Right" Width="26"
                         Foreground="#4A6070" FontFamily="{StaticResource UiFont}"
                         FontSize="8" TextAlignment="Right" VerticalAlignment="Center"/>
              <Grid Height="3" Margin="0,0,6,0" ClipToBounds="True" VerticalAlignment="Center">
                <Border Background="#1AFFFFFF" CornerRadius="1.5"/>
                <!-- Доля задаётся масштабом, а не шириной: сайдбар и панель
                     драфта разной ширины, а подвал у них общий. -->
                <Border Background="#C89B3C" CornerRadius="1.5"
                        HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform>
                    <ScaleTransform x:Name="SideDlDbFillT" ScaleX="0"/>
                  </Border.RenderTransform>
                </Border>
              </Grid>
            </DockPanel>
          </StackPanel>

          <StackPanel x:Name="SideDlApp" Visibility="Collapsed" Margin="16,0,16,7">
            <DockPanel>
              <TextBlock Text="release" DockPanel.Dock="Left" Width="34"
                         Foreground="#4A6070" FontFamily="{StaticResource UiFont}"
                         FontSize="8" VerticalAlignment="Center"/>
              <TextBlock x:Name="SideDlAppPct" Text="" DockPanel.Dock="Right" Width="26"
                         Foreground="#4A6070" FontFamily="{StaticResource UiFont}"
                         FontSize="8" TextAlignment="Right" VerticalAlignment="Center"/>
              <Grid Height="3" Margin="0,0,6,0" ClipToBounds="True" VerticalAlignment="Center">
                <Border Background="#1AFFFFFF" CornerRadius="1.5"/>
                <!-- Синяя, чтобы не путать с базой: две одинаковые полосы в
                     одном углу пришлось бы читать по подписи каждый раз. -->
                <Border Background="#5A8AC8" CornerRadius="1.5"
                        HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform>
                    <ScaleTransform x:Name="SideDlAppFillT" ScaleX="0"/>
                  </Border.RenderTransform>
                </Border>
              </Grid>
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ RESIZE HANDLES — 8 направлений ═══════════════════════════ -->
    <!-- Края -->
    <Rectangle Height="6" VerticalAlignment="Top"    Fill="Transparent" Cursor="SizeNS"  MouseLeftButtonDown="ResN"/>
    <Rectangle Height="6" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNS"  MouseLeftButtonDown="ResS"/>
    <Rectangle Width="6"  HorizontalAlignment="Left"  Fill="Transparent" Cursor="SizeWE" MouseLeftButtonDown="ResW"/>
    <Rectangle Width="6"  HorizontalAlignment="Right" Fill="Transparent" Cursor="SizeWE" MouseLeftButtonDown="ResE"/>
    <!-- Углы -->
    <Rectangle Width="12" Height="12" HorizontalAlignment="Left"  VerticalAlignment="Top"    Fill="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="ResNW"/>
    <Rectangle Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"    Fill="Transparent" Cursor="SizeNESW" MouseLeftButtonDown="ResNE"/>
    <Rectangle Width="12" Height="12" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNESW" MouseLeftButtonDown="ResSW"/>
    <Rectangle Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="ResSE"/>

  </Grid>
</Window>
