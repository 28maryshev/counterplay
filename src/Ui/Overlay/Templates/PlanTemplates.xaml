<ResourceDictionary x:Class="Counterplay.PlanTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:Counterplay">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Counterplay;component/src/Ui/Overlay/OverlayResources.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Строка «мой чемпион на роли» в фазе объявления (PlanList). -->
  <DataTemplate x:Key="PlanCardTemplate">
    <Border Margin="0,2" CornerRadius="4" Padding="10,6" Cursor="Hand"
            Background="{Binding CardBg}" BorderThickness="1.5" ToolTip="{Binding Tip}"
            MouseLeftButtonDown="PlanCard_Click" Tag="{Binding ChampionId}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{Binding CardBorder}"/>
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                <Condition Binding="{Binding IsSelected}" Value="False"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="BorderBrush" Value="#A0C89B3C"/>
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="96"/>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="62"/>
          <ColumnDefinition Width="110"/>
        </Grid.ColumnDefinitions>
        <Ellipse Width="40" Height="40" VerticalAlignment="Center" StrokeThickness="1.5">
          <Ellipse.Fill><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Ellipse.Fill>
          <Ellipse.Stroke><SolidColorBrush Color="{Binding Ring}"/></Ellipse.Stroke>
        </Ellipse>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
          <TextBlock Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis"
                     FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold"/>
          <TextBlock Text="{Binding Note}" Foreground="{Binding NoteBrush}"
                     Visibility="{Binding NoteVisibility}" TextTrimming="CharacterEllipsis"
                     FontFamily="{StaticResource UiFont}" FontSize="10.5"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding WrText}" Foreground="{Binding WrBrush}"
                     FontFamily="{StaticResource NumberFont}" FontSize="16" FontWeight="Bold"/>
          <TextBlock Text="{Binding GamesText}" Foreground="#8AA0B2" Margin="6,0,0,2"
                     VerticalAlignment="Bottom"
                     FontFamily="{StaticResource UiFont}" FontSize="11"/>
        </StackPanel>
        <!-- Форма: исход каждой из последних игр, старые слева -->
        <ItemsControl Grid.Column="3" ItemsSource="{Binding Form}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="8" Height="14" CornerRadius="2" Margin="0,0,3,0" Background="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding LpText}" Foreground="{Binding LpBrush}"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource NumberFont}" FontSize="15" FontWeight="Bold"/>
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding PatchText}" Foreground="{Binding PatchBrush}"
                     FontFamily="{StaticResource NumberFont}" FontSize="15" FontWeight="Bold"/>
          <TextBlock Text="{Binding DeltaText}" Foreground="{Binding DeltaBrush}" Margin="5,0,0,2"
                     VerticalAlignment="Bottom"
                     FontFamily="{StaticResource NumberFont}" FontSize="11" FontWeight="Bold"/>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
