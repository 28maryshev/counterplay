<ResourceDictionary x:Class="Counterplay.PhraseTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Counterplay;component/src/Ui/Overlay/OverlayResources.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Рамка кнопки полосы фраз: тёмная полупрозрачная, под курсором плотнее и
       в золотой рамке. Общая у карандаша (в разметке окна) и у кнопок фраз. -->
  <Style x:Key="PhraseChipFrame" TargetType="Border">
    <Setter Property="Height" Value="32"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="#B30E1620"/>
    <Setter Property="BorderBrush" Value="#594F6B85"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#E6182533"/>
        <Setter Property="BorderBrush" Value="#C89B3C"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Кнопка фразы (PhraseChip). Клик пишет фразу в чат драфта; после отправки
       кнопка на миг зеленеет с галочкой, а не ушло — краснеет с причиной
       (State). Длинная фраза обрезается многоточием, целиком — в подсказке. -->
  <DataTemplate x:Key="PhraseChipTemplate">
    <Border x:Name="Chip" Style="{StaticResource PhraseChipFrame}" Margin="0,0,4,0" Padding="6,0"
            Tag="{Binding Index}" ToolTip="{Binding Tip}" MouseLeftButtonDown="Phrase_Click">
      <!-- До двух строк: на кнопку пятой части центра влезает ~20 знаков, а
           фразы на немецком или французском длиннее. Дальше — многоточие. -->
      <TextBlock x:Name="Label" Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                 TextAlignment="Center" LineHeight="13" LineStackingStrategy="BlockLineHeight" MaxHeight="26"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="SemiBold"
                 Foreground="#D7DEE6"/>
    </Border>
    <DataTemplate.Triggers>
      <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
        <Setter TargetName="Label" Property="Foreground" Value="#FFFFFF"/>
      </Trigger>
      <DataTrigger Binding="{Binding State}" Value="sent">
        <Setter TargetName="Chip" Property="BorderBrush" Value="#3FD16A"/>
        <Setter TargetName="Chip" Property="Background" Value="#E0143A22"/>
        <Setter TargetName="Label" Property="Foreground" Value="#B9F5C9"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="fail">
        <Setter TargetName="Chip" Property="BorderBrush" Value="#E0584F"/>
        <Setter TargetName="Chip" Property="Background" Value="#E03A1414"/>
        <Setter TargetName="Label" Property="Foreground" Value="#FFC9C4"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
