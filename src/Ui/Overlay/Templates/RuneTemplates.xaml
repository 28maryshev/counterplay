<ResourceDictionary x:Class="Counterplay.RuneTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:Counterplay">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Counterplay;component/src/Ui/Overlay/OverlayResources.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Кнопка варианта рун на панели рун и сборки. -->
  <!-- Кнопка варианта рун: кейстоун крупно, остальные руны страницы
       мелкими иконками (основное дерево сверху, вторичное снизу). -->
  <DataTemplate x:Key="RuneOptionTemplate">
    <Border Margin="0,0,6,6" Padding="7,6" CornerRadius="7" Cursor="Hand"
            VerticalAlignment="Stretch"
            Background="{Binding Background}"
            BorderBrush="{Binding BorderBrush}" BorderThickness="1.5"
            MouseLeftButtonDown="RuneOption_Click" Tag="{Binding Index}">
      <Border.ToolTip>
        <ToolTip Background="#101823" BorderBrush="#557089" BorderThickness="1" Padding="10,8">
          <StackPanel MaxWidth="320">
            <TextBlock Text="{Binding TreeTitle}" TextWrapping="Wrap"
                       FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold"
                       Foreground="#F5D77A" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding PrimaryRunes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Image Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="7,0,0,0" MaxWidth="250">
                      <TextBlock Text="{Binding Name}"
                                 FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="Bold"
                                 Foreground="#D7DEE6"/>
                      <TextBlock Text="{Binding Desc}" TextWrapping="Wrap" LineHeight="13"
                                 FontFamily="{StaticResource UiFont}" FontSize="10"
                                 Foreground="#7C93A6"/>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding SubTreeTitle}" Margin="0,6,0,4"
                       FontFamily="{StaticResource UiFont}" FontSize="10" FontWeight="Bold"
                       Foreground="#8AA0B2"/>
            <ItemsControl ItemsSource="{Binding SecondaryRunes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="7,0,0,0" MaxWidth="250">
                      <TextBlock Text="{Binding Name}"
                                 FontFamily="{StaticResource UiFont}" FontSize="11" FontWeight="Bold"
                                 Foreground="#D7DEE6"/>
                      <TextBlock Text="{Binding Desc}" TextWrapping="Wrap" LineHeight="13"
                                 FontFamily="{StaticResource UiFont}" FontSize="10"
                                 Foreground="#7C93A6"/>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding ShardRunes}" Margin="0,6,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,4,0"
                         ToolTip="{Binding Desc}"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Tip}" TextWrapping="Wrap" Margin="0,8,0,0"
                       FontFamily="{StaticResource UiFont}" FontSize="10" LineHeight="15"
                       Foreground="#8AA0B2"/>
          </StackPanel>
        </ToolTip>
      </Border.ToolTip>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="{Binding KeystoneIcon}" Width="28" Height="28" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" MaxWidth="86" TextTrimming="CharacterEllipsis"
                     FontFamily="{StaticResource UiFont}" FontSize="10" FontWeight="Bold"
                     Foreground="#E6EDF3"/>
          <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
            <TextBlock Text="{Binding WinrateText}" VerticalAlignment="Center"
                       FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"
                       Foreground="{Binding WinrateBrush}"/>
            <TextBlock Text="{Binding GamesText}" Margin="4,0,0,0" VerticalAlignment="Center"
                       FontFamily="{StaticResource UiFont}" FontSize="9" Foreground="#6A8296"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding PrimaryMini}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Image Source="{Binding Icon}" Width="15" Height="15" Margin="0,0,2,0"
                       ToolTip="{Binding Name}" RenderOptions.BitmapScalingMode="HighQuality"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding SecondaryMini}" Margin="0,3,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Image Source="{Binding Icon}" Width="15" Height="15" Margin="0,0,2,0"
                       Opacity="0.85" ToolTip="{Binding Name}"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
