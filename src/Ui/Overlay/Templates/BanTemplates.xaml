<ResourceDictionary x:Class="Counterplay.BanTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:Counterplay">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Counterplay;component/src/Ui/Overlay/OverlayResources.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Карточка совета бана (BanFullList) и слот бана на панели банов команд. -->
  <DataTemplate x:Key="BanCardTemplate">
    <!-- Клик по карточке наводит бан в клиенте; рамка краснеет.
         Уже забанил союзник — карточка на месте, затемнена и
         перечёркнута, «БАН» справа нет (Gone). -->
    <Border Margin="0,3" CornerRadius="4" Padding="12,10" Cursor="Hand"
            Background="{Binding CardBg}" BorderThickness="1.5" Opacity="{Binding CardOpacity}"
            MouseLeftButtonDown="BanCard_Click" Tag="{Binding ChampionId}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{Binding CardBorder}"/>
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                <Condition Binding="{Binding IsSelected}" Value="False"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="BorderBrush" Value="#A0C84040"/>
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Rank}"
                   FontFamily="{StaticResource NumberFont}" FontSize="30" FontWeight="Bold"
                   Foreground="#E0584F" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Grid Grid.Column="1" Width="56" Height="56" VerticalAlignment="Center" Margin="0,0,12,0">
          <Ellipse>
            <Ellipse.Fill><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Ellipse.Fill>
            <Ellipse.Stroke><SolidColorBrush Color="#C84040"/></Ellipse.Stroke>
            <Ellipse.StrokeThickness>2</Ellipse.StrokeThickness>
          </Ellipse>
          <Grid Visibility="{Binding GoneVisibility}">
            <Ellipse Fill="#B0101820"/>
            <TextBlock Text="✕" Foreground="#FF5A5A" FontSize="33" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Foreground="White"
                     FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="Bold"/>
          <TextBlock Text="{Binding Reason}" Foreground="#9AB2C6"
                     FontFamily="{StaticResource UiFont}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{loc:T draft.banBadge}" Foreground="#E0584F"
                   FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold"
                   VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}"/>
        <!-- «Не советовать» — в правом верхнем углу, поверх отступа карточки -->
        <ContentControl Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource DislikeButton}"
                        Margin="0,-8,-10,0" Tag="{Binding ChampionId}"
                        MouseLeftButtonDown="BanDislike_Click"/>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- Слот бана: портрет с крестом, как в тир-листе, имя и бан-рейт под ним.
       Пустой слот — пунктирный круг: бан ещё не сделан или скрыт. -->
  <DataTemplate x:Key="BanSlot">
    <!-- Баны стоят сразу, без анимации: кольцо цвета команды
         (синее у наших, красное у врагов) поверх затемнения. -->
    <StackPanel HorizontalAlignment="Center" Margin="2,0" ToolTip="{Binding Tip}"
                Background="Transparent">
      <Grid Width="54" Height="54" HorizontalAlignment="Center" Margin="0,18,0,0">
        <!-- Забанили МОЕГО мейна (много игр за месяц): золотая
             квадратная рамка со скруглением 5 вокруг портрета — цвет
             моего слота в драфте — с мягким свечением. -->
        <Rectangle Margin="-22" RadiusX="5" RadiusY="5" StrokeThickness="2"
                   IsHitTestVisible="False" Visibility="{Binding MainVisibility}">
          <Rectangle.Stroke><SolidColorBrush Color="#F5D77A"/></Rectangle.Stroke>
          <Rectangle.Fill><SolidColorBrush Color="#26F5D77A"/></Rectangle.Fill>
          <Rectangle.Effect>
            <DropShadowEffect Color="#F5D77A" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
          </Rectangle.Effect>
        </Rectangle>
        <Grid Visibility="{Binding IconVisibility}">
          <Ellipse>
            <Ellipse.Fill><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Ellipse.Fill>
          </Ellipse>
          <!-- Забанен — затемнение и красный крест, как в тир-листе, но
               затемнение слабее (#68 против #B0): здесь забанены все, отличать
               не от кого, а лицо под тёмным слоем не узнавалось (владелец, 28.10). -->
          <Ellipse Fill="#68101820"/>
          <TextBlock Text="✕" Foreground="#FF5A5A" FontSize="33" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <!-- Кольцо команды — поверх затемнения, чтобы не тускнело -->
          <Ellipse StrokeThickness="2.5" IsHitTestVisible="False">
            <Ellipse.Stroke><SolidColorBrush Color="{Binding Frame}"/></Ellipse.Stroke>
          </Ellipse>
        </Grid>
        <Grid Visibility="{Binding EmptyVisibility}">
          <Ellipse StrokeThickness="1.5" StrokeDashArray="3 2" Fill="#0CFFFFFF">
            <Ellipse.Stroke><SolidColorBrush Color="{Binding Frame}"/></Ellipse.Stroke>
          </Ellipse>
          <TextBlock Text="{Binding Placeholder}" Foreground="#6E8598"
                     FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
      <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,25,0,0"
                 MaxWidth="78" TextTrimming="CharacterEllipsis"
                 FontFamily="{StaticResource UiFont}" FontSize="10" Foreground="{Binding NameBrush}"/>
      <TextBlock Text="{Binding Rate}" HorizontalAlignment="Center" Margin="0,1,0,0"
                 FontFamily="{StaticResource NumberFont}" FontSize="14" FontWeight="Bold"
                 Foreground="{Binding RateBrush}"/>
    </StackPanel>
  </DataTemplate>

  <!-- Бан в ряду под заголовком колонки команды: та же модель, что у слота
       панели банов, только маленький портрет без подписей — имя и бан-рейт
       в подсказке. Крест и кольцо цвета команды как у слота; забанили моего
       мейна — кольцо золотое. Затемнение слабее, а крест тоньше, чем у слота:
       при таком размере под ними иначе не узнать лицо. -->
  <DataTemplate x:Key="BanChip">
    <Grid Width="30" Height="30" Margin="0,0,5,0" ToolTip="{Binding Tip}" Background="Transparent">
      <Grid Visibility="{Binding IconVisibility}">
        <Ellipse>
          <Ellipse.Fill><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Ellipse.Fill>
        </Ellipse>
        <Ellipse Fill="#48101820"/>
        <TextBlock Text="✕" Foreground="#D8FF5A5A" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse StrokeThickness="1.5" IsHitTestVisible="False">
          <Ellipse.Stroke><SolidColorBrush Color="{Binding Frame}"/></Ellipse.Stroke>
        </Ellipse>
        <Ellipse StrokeThickness="2" Stroke="#F5D77A" IsHitTestVisible="False"
                 Visibility="{Binding MainVisibility}"/>
      </Grid>
      <Grid Visibility="{Binding EmptyVisibility}">
        <Ellipse StrokeThickness="1" StrokeDashArray="3 2" Fill="#0CFFFFFF">
          <Ellipse.Stroke><SolidColorBrush Color="{Binding Frame}"/></Ellipse.Stroke>
        </Ellipse>
        <TextBlock Text="{Binding Placeholder}" Foreground="#6E8598"
                   FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
