<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Counterplay</RootNamespace>
    <AssemblyName>Counterplay</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- для значка в системном трее (NotifyIcon) -->
    <Version>1.0.7</Version>             <!-- для локальной сборки; выпуск подставляет свой номер (release.ps1, -p:Version) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Иконка .exe и ярлыков (если положен файл assets\logo.ico) -->
    <ApplicationIcon Condition="Exists('assets\logo.ico')">assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Папка проверок собирается отдельным проектом (tests/PoolBias): если не
       исключить, её Main попадает в приложение вторым входом. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <!-- Логотип кладём рядом с приложением для окна/трея (если есть) -->
  <ItemGroup Condition="Exists('assets\logo.ico')">
    <None Include="assets\logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\logo.ico</Link>
    </None>
  </ItemGroup>

  <!-- Лицензии чужого кода (значки Tabler Icons, MIT) — рядом с приложением:
       MIT требует отдавать текст лицензии вместе с программой. -->
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Шрифт интерфейса Ubuntu Sans (Ubuntu Font Licence 1.0, Canonical) — встроен
       в сборку. Статические файлы по начертаниям: переменный шрифт WPF не умеет,
       показал бы одно начертание. Лицензия — в THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <Resource Include="assets\fonts\UbuntuSans-Regular.ttf" />
    <Resource Include="assets\fonts\UbuntuSans-Medium.ttf" />
    <Resource Include="assets\fonts\UbuntuSans-SemiBold.ttf" />
    <Resource Include="assets\fonts\UbuntuSans-Bold.ttf" />
  </ItemGroup>

  <!-- Эмблемы рангов (Community Dragon, CDN Riot) — для трекера сессии -->
  <ItemGroup>
    <Resource Include="assets\ranks\*.png" />
    <Resource Include="assets\flags\*.png" />
    <!-- Иконки ролей: свои, без сети (см. RoleIcons). -->
    <Resource Include="assets\roles\*.png" />
  </ItemGroup>

  <!-- Строки локализации интерфейса (en/ru/es/pt/de/fr/tr/ko) -->
  <ItemGroup>
    <EmbeddedResource Include="assets\i18n\*.json" />
  </ItemGroup>

  <!-- Секрет телеметрии: передаётся при сборке (-p:TelemetrySecret=…), в коде и в
       репозитории его нет. Без параметра приложение шлёт телеметрию без заголовка. -->
  <ItemGroup Condition="'$(TelemetrySecret)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TelemetrySecret</_Parameter1>
      <_Parameter2>$(TelemetrySecret)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- Пароль синхронизации хранится защищённым средствами Windows:
         файл бесполезен на другой машине и под другим пользователем. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
